<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Two permissions, and no more.

      There is deliberately NO android.permission.INTERNET. The app has no
      networking code, and without this permission it could not send his journal,
      his photo or his health data anywhere even if it tried. That is what makes
      the privacy promise on the Settings screen enforceable rather than a claim.

      Opening a support website hands a URL to the browser, and the crisis numbers
      use ACTION_DIAL, which only opens the dialler with the number filled in and
      needs no CALL_PHONE permission. Choosing a photo and saving a backup both go
      through the system picker, so no storage permission is needed either.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- So the app can tell whether a dialler or browser exists before offering one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".DadsVictoryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DadsVictory">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DadsVictory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires one of the three daily encouragements. Internal only. -->
        <receiver
            android:name=".notifications.DailyNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.dadsvictory.action.DAILY_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Alarms are cleared by a reboot, so they are rebuilt here. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Keeps "8am" meaning 8am after a flight or a manual clock change. -->
        <receiver
            android:name=".notifications.TimeChangedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
