<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device automatically — not to cloud backup, and not through a
  phone-to-phone transfer. Moving to a new phone is done with the encrypted export
  in Settings, which he controls and which is protected by a passphrase only he
  knows. This is what backs up the promise that his journal, his health data and
  his family photo stay where he put them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
